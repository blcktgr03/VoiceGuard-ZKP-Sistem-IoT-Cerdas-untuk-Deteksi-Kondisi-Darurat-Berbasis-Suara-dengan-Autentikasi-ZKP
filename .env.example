APP_ENV=development
DEBUG=true
PRELOAD_ML_MODELS=true
DATABASE_URL=sqlite:///./backend/database/app.db
UPLOAD_DIR=backend/uploads
LOG_DIR=backend/logs
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
EMERGENCY_THRESHOLD=0.7
EMERGENCY_HIGH_CONFIDENCE_THRESHOLD=0.85
WHISPER_ENGINE=faster-whisper
WHISPER_MODEL_NAME=small
WHISPER_MODEL_PATH=backend/models/faster-whisper-small
WHISPER_LANGUAGE=id
WHISPER_COMPUTE_TYPE=float32
WHISPER_BEAM_SIZE=5
WHISPER_NO_SPEECH_THRESHOLD=0.6
WHISPER_INITIAL_PROMPT=Transkripsikan ucapan bahasa Indonesia dari sistem deteksi darurat.
WHISPER_DEVICE=cpu
BERT_MODEL_NAME=backend/bert/trained_model_indobert_full
BERT_DEVICE=cpu
BERT_EMERGENCY_LABELS=Emergency,EMERGENCY,LABEL_1
BERT_NORMAL_LABELS=Normal,NORMAL,LABEL_0
CHALLENGE_TTL_SECONDS=120
AUTH_TOKEN_SECRET=change-this-auth-token-secret
AUTH_TOKEN_TTL_SECONDS=600
SERVER_SCHNORR_SECRET_KEY=7
